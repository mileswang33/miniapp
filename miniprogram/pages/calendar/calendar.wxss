page { background: #f7f8fa; }
.page { min-height: 100vh; padding: 48rpx 32rpx 140rpx; box-sizing: border-box; }
.header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 30rpx; }
.title { color: #1f2937; font-size: 48rpx; font-weight: 700; }
.subtitle { color: #8b95a7; font-size: 26rpx; margin-top: 10rpx; }
.today-button { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 64rpx; margin: 0; padding: 0; border-radius: 32rpx; background: #e9efff; color: #5376f6; font-size: 26rpx; line-height: 1; }
.today-button::after, .month-button::after, .add-small-button::after { border: none; }
.calendar-panel { background: #fff; border-radius: 20rpx; padding: 26rpx 22rpx 24rpx; box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, .04); }
.month-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.month-button { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin: 0; padding: 0; border-radius: 50%; background: #f2f4f8; color: #394150; font-size: 46rpx; line-height: 1; }
.month-title { color: #202938; font-size: 32rpx; font-weight: 700; }
.week-row, .day-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
.week-cell { height: 54rpx; color: #98a2b3; font-size: 24rpx; text-align: center; line-height: 54rpx; }
.day-cell { position: relative; display: flex; align-items: center; justify-content: center; height: 82rpx; border-radius: 18rpx; color: #394150; font-size: 28rpx; font-weight: 600; box-sizing: border-box; }
.day-cell.is-empty { pointer-events: none; }
.day-cell.is-today { color: #5376f6; background: #f3f6ff; }
.day-cell.is-selected { color: #fff; background: #5376f6; }
.day-number { line-height: 1; }
.note-dot { position: absolute; right: 8rpx; top: 8rpx; min-width: 28rpx; height: 28rpx; padding: 0 7rpx; border-radius: 14rpx; background: #16a085; color: #fff; font-size: 18rpx; line-height: 28rpx; text-align: center; box-sizing: border-box; }
.day-cell.is-selected .note-dot { background: #fff; color: #5376f6; }
.agenda-header { display: flex; align-items: center; justify-content: space-between; margin-top: 34rpx; }
.agenda-date { color: #202938; font-size: 34rpx; font-weight: 700; }
.agenda-count { color: #8b95a7; font-size: 25rpx; margin-top: 8rpx; }
.add-small-button { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin: 0; padding: 0; border-radius: 50%; background: #5376f6; color: #fff; font-size: 38rpx; line-height: 1; box-shadow: 0 10rpx 24rpx rgba(83, 118, 246, .24); }
.note-list { margin-top: 24rpx; }
.note-card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, .04); }
.note-title { color: #202938; font-size: 31rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.note-content { color: #697386; font-size: 27rpx; line-height: 1.5; margin-top: 12rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.note-time { color: #a1a9b5; font-size: 23rpx; margin-top: 16rpx; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 120rpx; }
.empty-icon { width: 104rpx; height: 104rpx; border-radius: 50%; background: #e9efff; color: #5b7cfa; display: flex; align-items: center; justify-content: center; font-size: 54rpx; }
.empty-title { color: #394150; font-size: 31rpx; font-weight: 600; margin-top: 26rpx; }
.empty-tip { color: #9aa3b2; font-size: 25rpx; margin-top: 12rpx; }
