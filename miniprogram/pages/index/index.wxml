<view class="page">
  <view class="header"><view><view class="title">我的备忘录</view><view class="subtitle">把重要的事情记下来</view></view><view class="count">{{notes.length}} 条</view></view>
  <view class="search-box"><text class="search-icon">⌕</text><input class="search-input" placeholder="搜索备忘录" value="{{keyword}}" bindinput="onSearchInput" /><text wx:if="{{keyword}}" class="clear-search" bindtap="clearSearch">×</text></view>
  <view wx:if="{{filteredNotes.length}}" class="note-list">
    <view wx:for="{{filteredNotes}}" wx:key="id" class="note-card" data-id="{{item.id}}" bindtap="editNote"><view class="note-main"><view class="note-title">{{item.title || '无标题'}}</view><view class="note-content">{{item.content || '暂无内容'}}</view><view class="note-time">{{item.updatedAtText}}</view></view><view class="delete-button" catchtap="deleteNote" data-id="{{item.id}}">删除</view></view>
  </view>
  <view wx:else class="empty-state"><view class="empty-icon">✎</view><view class="empty-title">{{keyword ? '没有找到相关内容' : '还没有备忘录'}}</view><view class="empty-tip">{{keyword ? '换个关键词试试' : '点击下方按钮，记录你的第一件事'}}</view></view>
  <button class="add-button" bindtap="createNote">＋ 新建备忘录</button>
</view>
