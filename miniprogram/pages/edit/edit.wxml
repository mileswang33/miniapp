<view class="page"><view class="field-label">标题</view><input class="title-input" maxlength="60" placeholder="给这条备忘录起个标题" value="{{title}}" bindinput="onTitleInput" /><view class="field-label content-label">内容</view><textarea class="content-input" maxlength="5000" auto-height placeholder="写下你想记住的内容..." value="{{content}}" bindinput="onContentInput" /><view class="word-count">{{content.length}} / 5000</view><button class="save-button" bindtap="saveNote">保存备忘录</button></view>
